APP_NAME="PostGenius Agent"
APP_ENV=local
APP_KEY=base64:0NjshvaBSO0hRLhQmVQLtn3pJG5XvbLB2HV5mXSi/lc=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=postgenius_agent
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_DEFAULT_PROVIDER=nebius
AI_REQUEST_TIMEOUT=120

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_DEFAULT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_TEMPERATURE=0.6
NEBIUS_MAX_TOKENS=4096

ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=12345678

RESEARCH_SEARCH_PROVIDER=tavily

TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=6

RESEARCH_MAX_QUERIES=6
RESEARCH_RESULTS_PER_QUERY=6
RESEARCH_MAX_SOURCE_CONTENT=4000

CREATIVE_IMAGE_PROVIDER=disabled
CREATIVE_OPENAI_API_KEY=
CREATIVE_OPENAI_IMAGE_MODEL=gpt-image-1
CREATIVE_STORAGE_DISK=local
CREATIVE_MIN_BRAND_SCORE=75

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.com/social/meta/callback
META_GRAPH_VERSION=v24.0
SOCIAL_ALLOWED_MEDIA_HOSTS=media.your-domain.com
META_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,instagram_basic,instagram_content_publish

ANALYTICS_ENABLED=true
ANALYTICS_LOOKBACK_DAYS=30
ANALYTICS_SYNC_LIMIT=100
ANALYTICS_MIN_SYNC_INTERVAL=360
ANALYTICS_GRAPH_TIMEOUT=25
ANALYTICS_MEMORY_MIN_SAMPLE=3
ANALYTICS_IG_METRICS=reach,likes,comments,saved,shares,total_interactions
ANALYTICS_FB_METRICS=post_impressions_unique,post_clicks,post_reactions_by_type_total

OPTIMIZATION_ENABLED=true
OPTIMIZATION_USE_AI=true
OPTIMIZATION_MIN_POSTS=3
OPTIMIZATION_MIN_REACH=20
OPTIMIZATION_MAX_POSTS=60
OPTIMIZATION_MAX_RECOMMENDATIONS=5
OPTIMIZATION_QUEUE=optimization

AGENT_GOVERNANCE_ENABLED=true
AGENT_GOVERNANCE_MAX_PENDING=100
AGENT_GOVERNANCE_APPROVAL_TTL=72
AGENT_GOVERNANCE_DAILY_LIMIT=100

AGENT_LOOP_ENABLED=false
AGENT_LOOP_QUEUE=agent-loop
AGENT_LOOP_MAX_STEPS=8
AGENT_LOOP_DAILY_CYCLES=3

PRODUCTION_READINESS_ENABLED=true
PUBLISH_KILL_SWITCH=true
PUBLISH_REQUIRE_GOVERNANCE=true
PUBLISH_DISPATCH_LIMIT=50
PUBLISH_STALE_MINUTES=20
INTERNAL_HEALTH_TOKEN=

POSTGENIUS_BRAND="PostGenius Agent"
POSTGENIUS_CONTACT_EMAIL=hello@your-public-domain.example
POSTGENIUS_CONTACT_TO=hello@your-public-domain.example
POSTGENIUS_PUBLIC_INDEXABLE=false
POSTGENIUS_SOCIAL_IMAGE=/postgenius/og-cover.svg
